# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-finance?retryWrites=true&w=majority

# Generate the three values below with: npm run hash-password
# Base64-encoded bcrypt hash of your login password.
APP_PASSWORD_HASH=
# Random string (at least 32 characters) used to sign the session cookie.
AUTH_SECRET=
# Random string; Vercel Cron sends it as a Bearer token to /api/cron/recurring.
CRON_SECRET=
